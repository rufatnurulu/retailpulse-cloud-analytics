  "bugs": {
    "url": "https://github.com/rufatnurulu/retailpulse-cloud-analytics/issues"
  },
  "homepage": "https://github.com/rufatnurulu/retailpulse-cloud-analytics#readme",
  "dependencies": {
    "chart.js": "^4.6.1",
    "firebase": "^13.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "vite": "^8.3.8"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.7"
  }
