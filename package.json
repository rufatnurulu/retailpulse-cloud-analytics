{
  "name": "retailpulse-cloud-analytics",
  "version": "1.0.0",
  "description": "A cloud-based retail sales analytics platform using Google Firebase, Python, SQL, and JavaScript.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/analytics.test.js && npm run test:firestore",
    "test:firestore": "firebase emulators:exec --only firestore --project demo-retailpulse \"node --test tests/firestore-rules.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rufatnurulu/retailpulse-cloud-analytics.git"
  },
