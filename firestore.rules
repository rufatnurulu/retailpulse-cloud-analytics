rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
  return request.auth != null;
}

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function canReadAs(roles) {
      return signedIn()
        && userProfile().active == true
        && userProfile().role in roles;
    }

    function canCreateOrder() {
      return signedIn()
        && userProfile().active == true
        && userProfile().role in ['admin', 'sales'];
    }

    function canAdjustStock() {
      return signedIn()
        && userProfile().active == true
        && userProfile().role in ['admin', 'inventory'];
    }

    function validId(id) {
      return id is string && id.matches('[A-Za-z0-9_-]{1,128}');
    }

    function validStock(stock) {
      return stock is int && stock >= 0 && stock <= 9007199254740991;
    }

    function orderStockChange(productDocId) {
      let next = request.resource.data;
      let orderPath = /databases/$(database)/documents/orders/$(next.last_order_id);
      let order = getAfter(orderPath).data;
      return next.diff(resource.data).affectedKeys().hasOnly(['stock', 'last_order_id'])
        && validId(next.last_order_id)
        && !exists(orderPath)
        && order.product_doc_id == productDocId
        && validStock(resource.data.stock) && validStock(next.stock)
        && resource.data.stock - next.stock == order.quantity;
    }

    function isToday(date) {
      let parts = date.split('-');
      return int(parts[0]) == request.time.year()
        && int(parts[1]) == request.time.month()
        && int(parts[2]) == request.time.day();
    }

    function validOrder(orderId) {
      let order = request.resource.data;
      let fields = ['order_id', 'customer_id', 'customer_doc_id', 'product_id', 'product_doc_id',
        'order_date', 'created_at', 'quantity', 'unit_price', 'total_amount', 'status'];
      return order.keys().hasAll(fields) && order.keys().hasOnly(fields)
        && validId(orderId) && order.order_id == orderId
        && order.customer_id is string && order.product_id is string
        && validId(order.product_doc_id) && validId(order.customer_doc_id)
        && order.order_date is string && order.order_date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && isToday(order.order_date)
        && order.created_at == request.time && order.status == 'Completed'
        && order.quantity is int && order.quantity > 0 && order.quantity <= 1000000
        && order.unit_price is number && order.unit_price >= 0
        && order.total_amount is number && order.total_amount >= 0
        && validOrderReferences(orderId, order);
    }

    function validOrderReferences(orderId, order) {
      let productPath = /databases/$(database)/documents/products/$(order.product_doc_id);
      let customer = get(/databases/$(database)/documents/customers/$(order.customer_doc_id)).data;
      let product = get(productPath).data;
      let next = getAfter(productPath).data;
      let price = product.get('price', null);
      let cents = order.unit_price * order.quantity * 100;
      return order.customer_id == customer.customer_id && order.product_id == product.product_id
        && order.unit_price == (price == null ? product.get('unit_price', null) : price)
        && cents <= 9007199254740991
        && order.total_amount == math.round(cents) / 100.0
        && next.last_order_id == orderId && product.get('last_order_id', null) != orderId
        && validStock(next.stock) && validStock(product.stock)
        && product.stock - next.stock == order.quantity;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    match /customers/{documentId} {
      allow read: if canReadAs(['admin', 'sales']);
      allow write: if false;
    }

    match /products/{documentId} {
      allow read: if canReadAs(['admin', 'sales', 'inventory', 'analyst']);

      allow update: if canAdjustStock()
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['stock'])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock <= 9007199254740991;

      allow update: if canCreateOrder() && orderStockChange(documentId);
      allow create, delete: if false;
    }

    match /orders/{documentId} {
      allow read: if canReadAs(['admin', 'sales', 'analyst']);

      allow create: if canCreateOrder() && validOrder(documentId);
      allow update, delete: if false;
    }
  }
}