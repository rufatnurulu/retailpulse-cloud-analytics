rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
  return request.auth != null;
}

    function userProfile() {
  return get(
    /databases/$(database)/documents/users/$(request.auth.uid)
  ).data;
}

function isAdmin() {
  return signedIn()
    && userProfile().active == true
    && userProfile().role == 'admin';
}
    function canAdjustStock() {
      return signedIn()
        && userProfile().active == true
        && userProfile().role in ['admin', 'inventory'];
    }

match /users/{userId} {
  allow read: if request.auth != null
    && request.auth.uid == userId;

  allow create, update, delete: if false;
}
    match /customers/{documentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /products/{documentId} {
      allow read: if signedIn();

      allow update: if canAdjustStock()
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['stock'])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock <= 9007199254740991;

      allow create, delete: if false;
    }

    match /orders/{documentId} {
      allow read: if signedIn();

      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'order_id',
          'customer_id',
          'product_id',
          'order_date',
          'quantity',
          'unit_price',
          'total_amount',
          'status'
        ])
        && request.resource.data.keys().hasOnly([
          'order_id',
          'customer_id',
          'product_id',
          'order_date',
          'quantity',
          'unit_price',
          'total_amount',
          'status'
        ])
        && request.resource.data.order_id is string
        && request.resource.data.customer_id is string
        && request.resource.data.product_id is string
        && request.resource.data.order_date is string
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.unit_price is number
        && request.resource.data.unit_price >= 0
        && request.resource.data.total_amount is number
        && request.resource.data.total_amount >= 0
        && request.resource.data.status == 'Completed';

      allow update, delete: if false;
    }
  }
}